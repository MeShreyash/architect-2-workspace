    MODEL["Model Gateway\nOpenAI-compatible / LiteLLM-style"]
    TOOLS["Tool / MCP Gateway"]
    SM["Sandbox Manager"]
    GIT["GitHub Service\nGitHub App"]
    DEPLOY["Deployment Service\nProvider adapters"]
  end

  subgraph DATA["State / Platform Services"]
    PG["PostgreSQL"]
    REDIS["Redis"]
    BUS["Event Bus\nKafka / SQS / PubSub"]
    OBJ["Object Storage\nlogs • traces • screenshots • artifacts"]
    SECRETS["Secrets Manager + KMS"]
    OBS["OpenTelemetry / Observability"]
  end

